# Copy to .env for local dev (Vite loads it; `npm run dev` serves /api/* too).
# On Vercel, set these as project environment variables instead.

# --- server-only: never prefix with VITE_ or they ship to the browser ---

# Google AI Studio key (https://aistudio.google.com/apikey). The free tier is
# enough for this tool. Leave empty to use the built-in deterministic engine.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite; gemini-3.8-flash = higher quality).
GEMINI_MODEL=

# HubSpot lead capture (see README). Portal defaults to FitBudd's (9058640) and
# each tool has its own default form (hashtag: e7410680-…, challenge: ca6c259d-…);
# set these only to point a tool at a different form. Token is optional.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
HUBSPOT_FORM_ID_HASHTAG_GENERATOR=
HUBSPOT_FORM_ID_FITNESS_CHALLENGE_GENERATOR=
HUBSPOT_PRIVATE_APP_TOKEN=

# --- public ---
# Dev only: 'true' sends events to HubSpot from `npm run dev` (real submissions).
VITE_TRACK_IN_DEV=
